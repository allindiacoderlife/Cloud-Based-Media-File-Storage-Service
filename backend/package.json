{
  "name": "cloud-storage-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "REST API Backend for Cloud-Based Media Storage Service",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit",
    "test": "tsx src/tests/auth-test.ts && tsx src/tests/storage-test.ts && tsx src/tests/folders-files-test.ts && tsx src/tests/sharing-test.ts && tsx src/tests/search-test.ts",
    "test:auth": "tsx src/tests/auth-test.ts",
    "test:storage": "tsx src/tests/storage-test.ts",
    "test:folders": "tsx src/tests/folders-files-test.ts",
    "test:sharing": "tsx src/tests/sharing-test.ts",
    "test:search": "tsx src/tests/search-test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.5.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "winston": "^3.17.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.9",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
