{
  "info": {
    "name": "CloudVault - Cloud-Based Media Storage API",
    "description": "Production REST API Collection for CloudVault Storage Service covering Auth, Files, Folders, Sharing, Link Sharing, Search, Starred & Recent Activities.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "folderId",
      "value": "",
      "type": "string"
    },
    {
      "key": "fileId",
      "value": "",
      "type": "string"
    },
    {
      "key": "shareToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health & System",
      "item": [
        {
          "name": "System Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\",\n  \"fullName\": \"Alex Cloud\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Get Current Profile (/me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "refresh"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "Folders Management",
      "item": [
        {
          "name": "Create Folder",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Financial Reports\",\n  \"parentId\": null\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/folders",
              "host": ["{{baseUrl}}"],
              "path": ["folders"]
            }
          }
        },
        {
          "name": "List Root Folders",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/folders",
              "host": ["{{baseUrl}}"],
              "path": ["folders"]
            }
          }
        },
        {
          "name": "Get Folder Details & Breadcrumbs",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/folders/{{folderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["folders", "{{folderId}}"]
            }
          }
        },
        {
          "name": "Rename / Move Folder",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Q3 Financial Reports\",\n  \"parentId\": null\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/folders/{{folderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["folders", "{{folderId}}"]
            }
          }
        },
        {
          "name": "Delete Folder (Cascade)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/folders/{{folderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["folders", "{{folderId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Files & Storage Engine",
      "item": [
        {
          "name": "Direct Multipart File Upload",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "" },
                { "key": "folderId", "value": "{{folderId}}", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/files/upload-direct",
              "host": ["{{baseUrl}}"],
              "path": ["files", "upload-direct"]
            }
          }
        },
        {
          "name": "Initiate Presigned Upload",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"architecture-spec.pdf\",\n  \"mimeType\": \"application/pdf\",\n  \"sizeBytes\": 1048576,\n  \"folderId\": null\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/files/init",
              "host": ["{{baseUrl}}"],
              "path": ["files", "init"]
            }
          }
        },
        {
          "name": "Complete Upload",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fileId\": \"{{fileId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/files/complete",
              "host": ["{{baseUrl}}"],
              "path": ["files", "complete"]
            }
          }
        },
        {
          "name": "List Files",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/files?folderId=root",
              "host": ["{{baseUrl}}"],
              "path": ["files"],
              "query": [{ "key": "folderId", "value": "root" }]
            }
          }
        },
        {
          "name": "Get Download Signed URL",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/files/{{fileId}}/download",
              "host": ["{{baseUrl}}"],
              "path": ["files", "{{fileId}}", "download"]
            }
          }
        },
        {
          "name": "Rename / Move File",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"architecture-spec-final.pdf\",\n  \"folderId\": null\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/files/{{fileId}}",
              "host": ["{{baseUrl}}"],
              "path": ["files", "{{fileId}}"]
            }
          }
        },
        {
          "name": "Delete File (Soft Delete)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/files/{{fileId}}",
              "host": ["{{baseUrl}}"],
              "path": ["files", "{{fileId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Sharing & Permissions",
      "item": [
        {
          "name": "Share Resource with User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resourceType\": \"file\",\n  \"resourceId\": \"{{fileId}}\",\n  \"granteeEmail\": \"collaborator@example.com\",\n  \"role\": \"viewer\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/shares",
              "host": ["{{baseUrl}}"],
              "path": ["shares"]
            }
          }
        },
        {
          "name": "List Shared with Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/shares/shared-with-me",
              "host": ["{{baseUrl}}"],
              "path": ["shares", "shared-with-me"]
            }
          }
        },
        {
          "name": "Create Public Share Link",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resourceType\": \"file\",\n  \"resourceId\": \"{{fileId}}\",\n  \"role\": \"viewer\",\n  \"password\": \"vaultpass123\",\n  \"expiresInDays\": 7\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/link-shares",
              "host": ["{{baseUrl}}"],
              "path": ["link-shares"]
            }
          }
        },
        {
          "name": "Access Public Link",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"vaultpass123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/link/{{shareToken}}/access",
              "host": ["{{baseUrl}}"],
              "path": ["link", "{{shareToken}}", "access"]
            }
          }
        }
      ]
    },
    {
      "name": "Search, Starred & Activity",
      "item": [
        {
          "name": "Full-text / Substring Search",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/search?q=report&category=document&sortBy=updated_at&sortOrder=desc",
              "host": ["{{baseUrl}}"],
              "path": ["search"],
              "query": [
                { "key": "q", "value": "report" },
                { "key": "category", "value": "document" },
                { "key": "sortBy", "value": "updated_at" },
                { "key": "sortOrder", "value": "desc" }
              ]
            }
          }
        },
        {
          "name": "Toggle Star Favorite",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resourceType\": \"file\",\n  \"resourceId\": \"{{fileId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/stars/toggle",
              "host": ["{{baseUrl}}"],
              "path": ["stars", "toggle"]
            }
          }
        },
        {
          "name": "List Starred Items",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/stars",
              "host": ["{{baseUrl}}"],
              "path": ["stars"]
            }
          }
        },
        {
          "name": "Get Recent Files & Activity Timeline",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/activity/recent",
              "host": ["{{baseUrl}}"],
              "path": ["activity", "recent"]
            }
          }
        }
      ]
    }
  ]
}
